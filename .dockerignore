# .dockerignore

# Virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Environment files (we'll use docker-compose environment)
.env

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp

# Tests
tests/
.pytest_cache/

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Other
*.md
*.log
.DS_Store
